{
  "compilerOptions": {
    "target": "ES2022",
    "strictNullChecks": true,
    "declaration": true,
    "module": "commonJS",
    "outDir": "build",
    "moduleResolution": "node",
    "noImplicitAny": true,
    "sourceMap": false,
    "noImplicitThis": false,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "lib": ["ES2022"],
    "esModuleInterop": true
  },
  "include": ["ts/**/*"],
  "exclude": ["build"],
  "compileOnSave": true
}
